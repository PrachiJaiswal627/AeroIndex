# ==============================================================================
# AIROINDEX - Environment Configuration Template
# ==============================================================================

# Backend REST API Base URL
# - In local development with Vite dev server proxy: use '/api' or 'http://localhost:5000/api'
# - In production or external backend: use 'https://api.airoindex.com/api'
VITE_API_BASE_URL=http://localhost:5000/api

# Target backend server for Vite dev server proxy (used in vite.config.js)
VITE_BACKEND_PROXY_TARGET=http://localhost:5000

# Feature Flags
# Set to 'true' to force mock/dummy data simulation regardless of backend availability
VITE_ENABLE_MOCK_FALLBACK=true

# Request Timeout (in milliseconds)
VITE_API_TIMEOUT=10000
